# =============================================================================
# Sentrais Intelligence Backbone - Terraform Variables Example
# =============================================================================
# Copy this file to terraform.tfvars and customize values as needed.
# =============================================================================

project_id   = "sentrais-backbone"
project_name = "Sentrais Intelligence Backbone"
region       = "us-central1"
zone         = "us-central1-a"

artifact_registry_repository = "sentrais-repo"

labels = {
  project     = "sentrais-backbone"
  environment = "production"
  managed_by  = "terraform"
}
